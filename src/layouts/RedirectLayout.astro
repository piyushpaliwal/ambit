---
/**
 * Full HTML document for legacy URL redirects.
 * Ensures crawlers see a valid <html><head> (fixes "Missing Head Element").
 */
interface Props {
  destination: string;
  title?: string;
}

const { destination, title = 'Redirecting…' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={destination} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | Ambit</title>
  </head>
  <body>
    <p>
      Redirecting to
      <a href={destination}>{destination}</a>…
    </p>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </body>
</html>
