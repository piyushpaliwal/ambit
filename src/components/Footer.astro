---
/** Optional props from country layouts — retained for compatibility. */
const { countryPhone = '', countryEmail = 'nishant@ambitsol.co' } = Astro.props;

const quickLinks = [
  ['Home', '/'],
  ['About Us', '/about'],
  ['Services', '/services/finance-accounting-tax/us/overview'],
  ['Industries', '/industries'],
  ['How it works', '/how-it-works'],
  ['Contact', '/contact'],
];

const services = [
  ['Accounting & Bookkeeping', '/services/finance-accounting-tax/us/accounting-bookkeeping'],
  ['Tax Preparation & Filing', '/services/finance-accounting-tax/us/tax-compliance'],
  ['Payroll Management', '/services/finance-accounting-tax/us/payroll'],
  ['Accounts Payable', '/services/accounts-payable'],
  ['Accounts Receivable', '/services/accounts-receivable'],
  ['Financial Reporting & Insights', '/services/finance-accounting-tax/us/financial-management'],
  ['Business & Firm Registration', '/services/finance-accounting-tax/us/business-formation'],
  ['Payroll Registration', '/services/finance-accounting-tax/us/payroll'],
];

const industries = [
  ['Accounting Firms', '/industries'],
  ['E-commerce', '/industries'],
  ['Startups', '/industries'],
  ['Real Estate', '/industries'],
  ['Healthcare', '/industries'],
  ['Small & Medium Businesses', '/industries'],
];

const markets = [
  {
    code: 'UK',
    name: 'United Kingdom',
    href: '/services/finance-accounting-tax/uk/overview',
    address: '5 Chancery Lane, London WC2A 1LG',
    phone: '+44 20 4577 1180',
    phoneHref: 'tel:+442045771180',
    email: 'uk@ambitaccounting.com',
  },
  {
    code: 'USA',
    name: 'United States',
    href: '/services/finance-accounting-tax/us/overview',
    address: '1180 Avenue of the Americas, New York, NY 10036',
    phone: '+1 (706) 894-9160',
    phoneHref: 'tel:+17068949160',
    email: 'us@ambitaccounting.com',
  },
  {
    code: 'UAE',
    name: 'United Arab Emirates',
    href: '/services/finance-accounting-tax/uae/overview',
    address: 'Business Bay, Dubai, United Arab Emirates',
    phone: '+971 4 000 0000',
    phoneHref: 'tel:+97140000000',
    email: 'uae@ambitaccounting.com',
  },
];

const regions = [
  { code: 'US', label: 'United States', href: '/services/finance-accounting-tax/us/overview' },
  { code: 'UK', label: 'United Kingdom', href: '/services/finance-accounting-tax/uk/overview' },
  { code: 'UAE', label: 'United Arab Emirates', href: '/services/finance-accounting-tax/uae/overview' },
];
---

<footer style="background-color: #0B1220;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Top: brand + newsletter -->
    <div class="py-12 lg:py-14 flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 lg:gap-12">
      <div class="max-w-md">
        <a href="/" class="inline-block mb-5">
          <img src="/images/logo-white.png" alt="Ambit Tax and Accounting Services" class="h-14 sm:h-16 lg:h-[72px] w-auto" />
        </a>
        <p
          style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 14px; line-height: 22px; color: rgba(255,255,255,0.72);"
        >
          Outsourced accounting, tax and payroll for businesses across the United Kingdom, United States and United Arab Emirates.
        </p>
      </div>

      <form
        class="w-full lg:w-auto lg:min-w-[340px] xl:min-w-[400px]"
        x-data="{ email: '', sent: false, loading: false }"
        @submit.prevent="
          if (!email) return;
          loading = true;
          const fd = new FormData();
          fd.append('access_key', '393035a6-1d5a-44b0-9df3-d97b614ca691');
          fd.append('subject', 'Newsletter Signup - Ambit Website');
          fd.append('email', email);
          fetch('https://api.web3forms.com/submit', { method: 'POST', body: fd })
            .then(() => { sent = true; loading = false; })
            .catch(() => { loading = false; });
        "
      >
        <div
          class="flex items-center gap-2 pl-5 pr-1.5 py-1.5 rounded-full"
          style="background-color: #121A2B; border: 1px solid #2A3448;"
        >
          <input
            type="email"
            name="email"
            required
            x-model="email"
            placeholder="you@company.com"
            class="flex-1 min-w-0 bg-transparent border-0 outline-none text-sm"
            style="font-family: 'DM Sans', sans-serif; color: #FFFFFF;"
            :disabled="sent || loading"
          />
          <button
            type="submit"
            class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 transition-opacity hover:opacity-90 disabled:opacity-60"
            style="background-color: #2738C0;"
            :disabled="sent || loading"
            :aria-label="sent ? 'Subscribed' : 'Subscribe'"
          >
            <template x-if="!sent">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </template>
            <template x-if="sent">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </template>
          </button>
        </div>
      </form>
    </div>

    <div style="border-top: 1px solid #1E293B;"></div>

    <!-- Middle: link columns + markets -->
    <div class="py-12 lg:py-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <div>
        <h4
          class="uppercase mb-5"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.14em; color: #C5A880;"
        >
          Quick Links
        </h4>
        <ul class="space-y-3">
          {quickLinks.map(([label, href]) => (
            <li>
              <a
                href={href}
                class="transition-opacity hover:opacity-80"
                style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 14px; line-height: 1.4; color: #FFFFFF;"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4
          class="uppercase mb-5"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.14em; color: #C5A880;"
        >
          Our Services
        </h4>
        <ul class="space-y-3">
          {services.map(([label, href]) => (
            <li>
              <a
                href={href}
                class="transition-opacity hover:opacity-80"
                style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 14px; line-height: 1.4; color: #FFFFFF;"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4
          class="uppercase mb-5"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.14em; color: #C5A880;"
        >
          Industries
        </h4>
        <ul class="space-y-3">
          {industries.map(([label, href]) => (
            <li>
              <a
                href={href}
                class="transition-opacity hover:opacity-80"
                style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 14px; line-height: 1.4; color: #FFFFFF;"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4
          class="uppercase mb-5"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.14em; color: #C5A880;"
        >
          Our Markets
        </h4>
        <div class="space-y-6">
          {markets.map((m) => (
            <div>
              <a href={m.href} class="inline-flex items-center gap-2.5 mb-2.5 group">
                <span
                  class="inline-flex items-center justify-center px-2 py-0.5 rounded-full"
                  style="font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 10px; letter-spacing: 0.06em; color: #C5A880; border: 1px solid #C5A880;"
                >
                  {m.code}
                </span>
                <span
                  class="transition-opacity group-hover:opacity-80"
                  style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 14px; color: #FFFFFF;"
                >
                  {m.name}
                </span>
              </a>
              <p
                class="mb-2"
                style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 13px; line-height: 1.45; color: rgba(255,255,255,0.55);"
              >
                {m.address}
              </p>
              <div class="space-y-1.5">
                <a
                  href={m.phoneHref}
                  class="flex items-center gap-2 transition-opacity hover:opacity-80"
                  style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 13px; color: rgba(255,255,255,0.72);"
                >
                  <svg class="w-3.5 h-3.5 flex-shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  {m.phone}
                </a>
                <a
                  href={`mailto:${m.email}`}
                  class="flex items-center gap-2 transition-opacity hover:opacity-80"
                  style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 13px; color: rgba(255,255,255,0.72);"
                >
                  <svg class="w-3.5 h-3.5 flex-shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  {m.email}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <div style="border-top: 1px solid #1E293B;"></div>

    <!-- Bottom: legal + region -->
    <div class="py-6 flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-6">
      <p
        class="lg:flex-1"
        style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 13px; color: rgba(255,255,255,0.55);"
      >
        © 2026 Ambit Tax &amp; Accounting. All rights reserved
      </p>

      <div class="flex flex-wrap items-center gap-5 lg:justify-center">
        {[
          ['Privacy Policy', '/privacy'],
          ['Terms', '/terms'],
          ['Cookies', '/cookies'],
        ].map(([label, href]) => (
          <a
            href={href}
            class="transition-opacity hover:opacity-80"
            style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 13px; color: rgba(255,255,255,0.72);"
          >
            {label}
          </a>
        ))}
      </div>

      <div
        class="lg:flex-1 lg:flex lg:justify-end relative"
        x-data="{ open: false, current: 'US' }"
        @click.outside="open = false"
      >
        <button
          type="button"
          class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-80"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 13px; color: #FFFFFF;"
          @click="open = !open"
          :aria-expanded="open.toString()"
          aria-haspopup="listbox"
        >
          <span x-text="current">US</span>
          <svg class="w-3.5 h-3.5 opacity-70 transition-transform" :class="open && 'rotate-180'" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div
          x-show="open"
          x-cloak
          x-transition
          class="absolute bottom-full right-0 mb-2 min-w-[160px] rounded-lg overflow-hidden z-20"
          style="background-color: #121A2B; border: 1px solid #2A3448; box-shadow: 0 12px 32px rgba(0,0,0,0.35);"
          role="listbox"
        >
          {regions.map((r) => (
            <a
              href={r.href}
              class="block px-4 py-2.5 text-left transition-colors hover:bg-white/5"
              style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 13px; color: #FFFFFF;"
              @click={`current = '${r.code}'; open = false`}
            >
              {r.code} — {r.label}
            </a>
          ))}
        </div>
      </div>
    </div>

  </div>
</footer>
