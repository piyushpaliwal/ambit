---
---

  <!-- ===== CTA / FORM ===== -->
  <section id="contact" class="py-24" style="background-color: #F1F5F9; border-top: 1px solid #E2E8F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">

        <div>
          <p
            class="uppercase mb-4"
            style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 18px; line-height: 31px; letter-spacing: 1.63px; color: #2738C0;"
          >
            Get Started
          </p>
          <h2
            class="mb-4"
            style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #0F172A;"
          >
            Let's get your
            <span
              class="inline-block"
              style="font-family: 'Segoe Script', 'Yellowtail', cursive; font-weight: 400; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #2738C0; margin: 0 0.1em;"
            >finance</span>
            function in order
          </h2>
          <p
            class="mb-8"
            style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 16px; line-height: 26px; color: #0F172AB2;"
          >
            Whether you need accounting, tax, payroll, or advisory support, the right structure makes all the difference. Get clarity, stay compliant, and move forward with confidence.
          </p>

          <!-- Office image -->
          <div class="rounded-2xl overflow-hidden shadow-lg mb-8">
            <img
              src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=600&q=80&auto=format&fit=crop"
              alt="Professional office team"
              class="w-full h-52 object-cover"
            />
          </div>

          <div class="space-y-4">
            {[
              { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Free initial consultation, no commitment' },
              { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', text: 'Response within 24 hours' },
              { icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z', text: 'Dedicated account manager assigned' },
            ].map(item => (
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background: linear-gradient(135deg, #1a4480, #1e5ab5);">
                  <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
                  </svg>
                </div>
                <span class="text-sm text-gray-600">{item.text}</span>
              </div>
            ))}
          </div>
          <p class="mt-6 text-sm text-gray-500">
            <span class="font-semibold text-gray-700">US direct line:</span> <a href="tel:+17064038982" class="hover:underline" style="color: #1a4480;">+1 (706) 403 8982</a> / <a href="tel:+17068130007" class="hover:underline" style="color: #1a4480;">+1 (706) 813 0007</a><br/>
            <span class="font-semibold text-gray-700">UAE direct line:</span> <a href="tel:+971567105833" class="hover:underline" style="color: #1a4480;">+971 567105833</a>
          </p>
        </div>

        <div class="rounded-2xl p-8 bg-white shadow-xl border border-gray-100" x-data="{ submitted: false, loading: false }">
          <h3 class="text-lg font-bold text-gray-900 mb-1">Book Your Free Consultation</h3>
          <p class="text-xs text-gray-400 mb-6">Fill in the form and we'll get back to you within 24 hours.</p>
          <form class="space-y-4" x-show="!submitted"
            @submit.prevent="
              loading = true;
              fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                body: new FormData($el)
              }).then(() => { submitted = true; loading = false; });
            ">
            <input type="hidden" name="access_key" value="393035a6-1d5a-44b0-9df3-d97b614ca691" />
            <input type="hidden" name="subject" value="New Consultation Request - Ambit Website" />
            <div class="grid sm:grid-cols-2 gap-4">
              <input type="text" name="name" placeholder="Your Name" required class="w-full px-4 py-3 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 transition-all" style="border: 1px solid #E2E8F0;" />
              <input type="text" name="company" placeholder="Company Name" class="w-full px-4 py-3 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 transition-all" style="border: 1px solid #E2E8F0;" />
            </div>
            <input type="email" name="email" placeholder="Email Address" required class="w-full px-4 py-3 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 transition-all" style="border: 1px solid #E2E8F0;" />
            <input type="tel" name="phone" placeholder="Phone Number" class="w-full px-4 py-3 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 transition-all" style="border: 1px solid #E2E8F0;" />
            <select name="service" class="w-full px-4 py-3 rounded-xl text-sm text-gray-500 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 transition-all" style="border: 1px solid #E2E8F0;">
              <option value="">Select Service Needed</option>
              <option>Accounting & Bookkeeping</option>
              <option>Tax Preparation</option>
              <option>Payroll Management</option>
              <option>Financial Reporting</option>
              <option>Company Formation</option>
            </select>
            <textarea rows="3" name="message" placeholder="Describe briefly what you need..." required class="w-full px-4 py-3 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 transition-all resize-none" style="border: 1px solid #E2E8F0;"></textarea>
            <button type="submit" :disabled="loading" class="w-full py-4 text-sm font-bold text-white rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-xl" style="background: linear-gradient(135deg, #1a4480 0%, #1e5ab5 100%); box-shadow: 0 4px 16px rgba(26,68,128,0.35);">
              <span x-show="!loading">Book Free Consultation &rarr;</span>
              <span x-show="loading">Sending...</span>
            </button>
            <p class="text-xs text-center text-gray-400">No spam. No commitment. Just expert advice.</p>
          </form>
          <div x-show="submitted" x-transition class="py-10 text-center">
            <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4" style="background-color: #ECFDF5;">
              <svg class="w-7 h-7" style="color: #22C55E;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="text-base font-bold text-gray-900 mb-1">Message Sent!</div>
            <div class="text-sm text-gray-500">We'll get back to you within 24 hours.</div>
          </div>
        </div>

      </div>
    </div>
  </section>
