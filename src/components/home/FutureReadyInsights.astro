---
---

  <!-- ===== FUTURE-READY INSIGHTS ===== -->
  <section class="py-24" style="background-color: #0F172A;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left: Chart visual -->
        <div class="relative">
          <div class="rounded-2xl p-8 border" style="background-color: #1E293B; border-color: #334155;">
            <p class="text-xs text-gray-400 mb-6 font-medium tracking-wide uppercase">Financial Overview - Q4 2024</p>
            <!-- Bar chart visual -->
            <div class="flex items-end gap-3 h-32 mb-4">
              {[60, 80, 45, 95, 70, 88, 55, 100, 75, 90, 65, 85].map((h, i) => (
                <div class="flex-1 rounded-t transition-all" style={`height: ${h}%; background: ${i % 3 === 0 ? 'linear-gradient(to top, #1a4480, #2563eb)' : i % 3 === 1 ? 'linear-gradient(to top, #1E3A5F, #1a4480)' : 'linear-gradient(to top, #0F2847, #1E3A5F)'}; opacity: ${0.5 + (h/200)};`}></div>
              ))}
            </div>
            <div class="flex justify-between text-xs text-gray-500">
              {['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].map(m => (
                <span>{m}</span>
              ))}
            </div>
            <!-- Metric cards -->
            <div class="grid grid-cols-3 gap-3 mt-6">
              {[
                { label: 'Revenue', val: '+24%', up: true },
                { label: 'Expenses', val: '-12%', up: false },
                { label: 'Net Profit', val: '+31%', up: true },
              ].map(m => (
                <div class="p-3 rounded-lg" style="background-color: #0F172A;">
                  <p class="text-xs text-gray-500 mb-1">{m.label}</p>
                  <p class="text-sm font-black" style={`color: ${m.up ? '#4ade80' : '#f87171'};`}>{m.val}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Text -->
        <div>
          <p class="text-xs font-semibold tracking-[0.15em] uppercase mb-3" style="color: #93B4D4;">Financial Reporting</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-4" style="letter-spacing: -0.02em;">
            Insights That Drive<br/>Better Decisions
          </h2>
          <div class="w-10 h-px mb-6" style="background-color: #1a4480;"></div>
          <p class="text-gray-400 leading-relaxed mb-8 text-sm">
            Clear, structured financial reporting that helps you understand performance, manage cash flow, and make informed decisions across your business.
          </p>
          <ul class="space-y-4 mb-8">
            {[
              { title: 'Real-time financial visibility', desc: 'Up-to-date reports that show where your business stands at any point in time' },
              { title: 'Cash flow clarity', desc: 'Understand inflows, outflows, and future positions with structured tracking' },
              { title: 'Error identification and control', desc: 'Early identification of discrepancies to avoid larger issues later' },
              { title: 'Custom reporting based on your business', desc: 'Reports structured around what matters to your operations' },
              { title: 'Faster monthly closing', desc: 'Well-managed processes that reduce delays in reporting cycles' },
            ].map(item => (
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" style="background: linear-gradient(135deg, #1a4480, #1e5ab5);">
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span class="text-sm text-gray-300"><strong class="text-white">{item.title}</strong><br/>{item.desc}</span>
              </li>
            ))}
          </ul>
          <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white rounded transition-all hover:-translate-y-0.5" style="background: linear-gradient(135deg, #1a4480 0%, #1e5ab5 100%); box-shadow: 0 4px 16px rgba(26,68,128,0.4);">
            Speak to an Advisor
          </a>
        </div>

      </div>
    </div>
  </section>
