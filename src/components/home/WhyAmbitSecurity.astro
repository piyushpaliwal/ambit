---
const whyItems = [
  {
    title: 'Structured Delivery',
    desc: 'Work is aligned to existing systems and workflows, not layered on top of them.',
    icon: 'shield',
  },
  {
    title: 'Consistency Across Engagements',
    desc: 'Outputs remain uniform across teams, periods, and jurisdictions without dependency on rework.',
    icon: 'refresh',
  },
  {
    title: 'Control Built Into Process',
    desc: 'Clear review layers and defined workflows ensure reliability as volume and complexity increase.',
    icon: 'badge',
  },
  {
    title: 'Integrated Approach',
    desc: 'Finance, operational support, and delivery functions are managed as connected components.',
    icon: 'bolt',
  },
  {
    title: 'Scalable Capacity',
    desc: 'Teams expand in line with requirements without increasing internal complexity.',
    icon: 'users',
  },
  {
    title: 'Cost Transparency',
    desc: 'Clear, predictable pricing with complete visibility into scopes and resource allocation — no hidden costs.',
    icon: 'cost',
  },
];

const securityPoints = [
  'ISO 27001 certified information security management',
  'GDPR-aligned data handling and privacy controls',
  'Role-based access with named accountability',
  'Encrypted transfers and controlled document workflows',
  'Monitoring, audit trails and ongoing risk reviews',
  'NDA-backed confidentiality for every team member',
];

const securityPillars = [
  {
    title: 'Access Control',
    desc: 'Role-based permissions and least-privilege access so only the people on your file can see your data.',
    icon: 'lock',
  },
  {
    title: 'Encryption',
    desc: 'Secure data handling in transit and at rest, with controlled channels for file exchange.',
    icon: 'key',
  },
  {
    title: 'Governance',
    desc: 'ISO 27001-aligned policies, risk assessments, and documented review of security controls.',
    icon: 'badge',
  },
  {
    title: 'Monitoring',
    desc: 'Audit logs and oversight so unusual activity can be spotted and addressed quickly.',
    icon: 'eye',
  },
  {
    title: 'Personnel Security',
    desc: 'Confidentiality obligations, NDAs, and clear accountability for everyone handling client data.',
    icon: 'users',
  },
  {
    title: 'Business Continuity',
    desc: 'Backups and recovery practices designed to keep delivery running without exposing information.',
    icon: 'server',
  },
];
---

<!-- ===== WHY AMBIT + SECURITY ===== -->
<section id="why-ambit" class="py-20 lg:py-28" style="background-color: #FFFFFF;">
  <div class="w-full max-w-none mx-auto px-4 sm:px-6 lg:px-10 xl:px-14 2xl:px-20">

    <!-- Why Ambit -->
    <div class="mb-16 lg:mb-20">
      <p
        class="uppercase mb-4"
        style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 18px; line-height: 31px; letter-spacing: 1.63px; color: #2738C0;"
      >
        Why Ambit
      </p>
      <h2
        class="mb-4 max-w-3xl"
        style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #0F172A;"
      >
        Built for
        <span
          class="inline-block"
          style="font-family: 'Segoe Script', 'Yellowtail', cursive; font-weight: 400; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #2738C0; margin: 0 0.12em;"
        >clarity</span>
        at every stage
      </h2>
      <p
        class="mb-12 max-w-2xl"
        style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 18px; line-height: 31px; letter-spacing: 0; color: #0F172AB2;"
      >
        Financial work rarely fails at the task level. The issue is usually how it is structured, reviewed, and maintained over time.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {whyItems.map((item) => (
          <div
            class="bg-white rounded-[15px] p-7 flex flex-col transition-all hover:-translate-y-0.5"
            style="box-shadow: 0 2px 16px rgba(15,23,42,0.05); border: 1px solid #EBE7E1;"
          >
            <div
              class="w-11 h-11 rounded-full flex items-center justify-center mb-5"
              style="background-color: #E8ECFB;"
            >
              {item.icon === 'shield' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              )}
              {item.icon === 'refresh' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              )}
              {item.icon === 'badge' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              )}
              {item.icon === 'bolt' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              )}
              {item.icon === 'users' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              )}
              {item.icon === 'user' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              )}
              {item.icon === 'cost' && (
                <svg class="w-5 h-5" style="color: #2738C0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              )}
            </div>
            <h3
              class="mb-2"
              style="font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 18px; line-height: 26px; letter-spacing: -0.3px; color: #0F172A;"
            >
              {item.title}
            </h3>
            <p
              style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 15px; line-height: 24px; color: #0F172AB2;"
            >
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Security (same section) -->
    <div
      id="security"
      class="rounded-[24px] overflow-hidden"
      style="background-color: #0B1220;"
    >
      <div class="grid lg:grid-cols-2 gap-0 items-stretch">
        <div class="p-8 sm:p-10 lg:p-14 flex flex-col justify-center">
          <p
            class="uppercase mb-4"
            style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 14px; line-height: 20px; letter-spacing: 2px; color: #C5A880;"
          >
            Security
          </p>
          <h3
            class="mb-4 max-w-lg"
            style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(26px, 3.5vw, 36px); line-height: 1.2; color: #FFFFFF;"
          >
            Your data stays
            <span
              class="inline-block"
              style="font-family: 'Segoe Script', 'Yellowtail', cursive; font-weight: 400; font-size: clamp(26px, 3.5vw, 36px); line-height: 1.2; color: #C5A880; margin: 0 0.12em;"
            >protected</span>
          </h3>
          <p
            class="mb-8 max-w-md"
            style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 16px; line-height: 26px; color: rgba(255,255,255,0.65);"
          >
            A structured, risk-based security framework — access controls, encryption, monitoring and personnel obligations — so finance work stays confidential as well as accurate.
          </p>

          <div class="flex flex-wrap gap-2.5 mb-8">
            {['ISO 27001 Certified', 'GDPR Aligned', 'NDA Bound Teams', 'Encrypted Transfers', 'Audit Controls'].map((badge) => (
              <span
                class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold"
                style="background-color: rgba(197,168,128,0.12); color: #C5A880; border: 1px solid rgba(197,168,128,0.35);"
              >
                {badge}
              </span>
            ))}
          </div>

          <ul class="space-y-3.5">
            {securityPoints.map((point) => (
              <li class="flex items-start gap-3">
                <span
                  class="w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5"
                  style="background: linear-gradient(135deg, #2738C0, #3B4CCA);"
                >
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span
                  style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 15px; line-height: 22px; color: rgba(255,255,255,0.8);"
                >
                  {point}
                </span>
              </li>
            ))}
          </ul>

          <div class="mt-10">
            <a
              href="/privacy"
              class="inline-flex items-center gap-3 pl-6 pr-1.5 py-1.5 text-sm font-semibold rounded-full transition-all hover:-translate-y-0.5"
              style="font-family: 'DM Sans', sans-serif; background-color: #FFFFFF; color: #0F172A; border: 1.5px solid #D6D1C9; box-shadow: 0 2px 10px rgba(15,23,42,0.04);"
            >
              Read our privacy practices
              <span class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #2738C0;">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
              </span>
            </a>
          </div>
        </div>

        <div class="relative min-h-[280px] lg:min-h-full flex flex-col items-center justify-center gap-8 p-10 lg:p-14" style="background: radial-gradient(circle at 50% 40%, #1E293B 0%, #0B1220 70%);">
          <div
            class="absolute inset-0 opacity-30 pointer-events-none"
            style="background: radial-gradient(circle at 70% 30%, rgba(39,56,192,0.35) 0%, transparent 55%);"
          ></div>
          <img
            src="/images/security.png"
            alt="Data security and protection"
            class="relative z-10 w-full max-w-[220px] lg:max-w-[280px] h-auto object-contain"
            loading="lazy"
          />
          <div class="relative z-10 grid grid-cols-2 gap-3 w-full max-w-sm">
            {[
              { val: 'ISO', label: '27001' },
              { val: 'GDPR', label: 'Aligned' },
              { val: '24/7', label: 'Controls' },
              { val: '100%', label: 'NDA Bound' },
            ].map((stat) => (
              <div
                class="rounded-xl px-4 py-3 text-center"
                style="background-color: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);"
              >
                <p style="font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 18px; color: #C5A880;">{stat.val}</p>
                <p style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 12px; color: rgba(255,255,255,0.55);">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Security pillars -->
      <div class="px-6 sm:px-8 lg:px-14 pb-10 lg:pb-14" style="border-top: 1px solid rgba(255,255,255,0.08);">
        <p
          class="pt-10 mb-6 uppercase"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 13px; letter-spacing: 2px; color: #C5A880;"
        >
          How we protect your information
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
          {securityPillars.map((pillar) => (
            <div
              class="rounded-2xl p-6 transition-all hover:-translate-y-0.5"
              style="background-color: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);"
            >
              <div
                class="w-10 h-10 rounded-full flex items-center justify-center mb-4"
                style="background-color: rgba(39,56,192,0.25); border: 1px solid rgba(39,56,192,0.4);"
              >
                {pillar.icon === 'lock' && (
                  <svg class="w-5 h-5" style="color: #93B4D4;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                )}
                {pillar.icon === 'key' && (
                  <svg class="w-5 h-5" style="color: #93B4D4;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                )}
                {pillar.icon === 'badge' && (
                  <svg class="w-5 h-5" style="color: #93B4D4;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                )}
                {pillar.icon === 'eye' && (
                  <svg class="w-5 h-5" style="color: #93B4D4;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                )}
                {pillar.icon === 'users' && (
                  <svg class="w-5 h-5" style="color: #93B4D4;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                )}
                {pillar.icon === 'server' && (
                  <svg class="w-5 h-5" style="color: #93B4D4;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
                )}
              </div>
              <h4
                class="mb-2"
                style="font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 16px; color: #FFFFFF;"
              >
                {pillar.title}
              </h4>
              <p
                style="font-family: 'DM Sans', sans-serif; font-weight: 400; font-size: 14px; line-height: 22px; color: rgba(255,255,255,0.6);"
              >
                {pillar.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
