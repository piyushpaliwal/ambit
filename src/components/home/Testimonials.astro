---
const testimonials = [
  {
    quote: "Thanks to Ambit KPO Services, we've seen an increase in revenue. Their team ensures a seamless experience with frequent communication, effective task management, and prompt responses. Their dedication and accuracy stand out.",
    name: 'Sofia, Roy',
    role: 'Managing Partner, CPA Firm - New York',
    initials: 'SR',
  },
  {
    quote: 'Ambit KPO Services adapted to our processes with ease, delivering monthly financials quickly and communicating effectively through various channels. Their commitment to building a long-term relationship, even under less-than-ideal terms, truly impressed me.',
    name: 'Greg Johnson, Georgia',
    role: 'CEO, E-commerce Startup - Georgia',
    initials: 'GJ',
  },
  {
    quote: 'There are not enough words to tell you how helpful Nishant and his firm have been in helping me with bookkeeping and accounting needs. I have worked with outsourcing firms and have never been as satisfied as I am with Nishant Sharma.',
    name: 'CPA Firm in Georgia',
    role: 'CPA Firm in Georgia',
    initials: 'CF',
  },
  {
    quote: 'Finding a reliable accountant was crucial, and Ambit KPO Services has exceeded expectations. Their professionalism, attention to detail, and responsiveness have been outstanding. They provided expert advice and proactive solutions, making a significant difference for my business.',
    name: 'Rafael Emiliani',
    role: 'Managing Partner, CPA Firm - New York',
    initials: 'RE',
  },
  {
    quote: "I've worked with Nishant through the past tax season. His work is reliable, accurate, and he was able to help our firm with taxes and bookkeeping for a variety of businesses and clients.",
    name: 'CPA Firm in Florida',
    role: 'CPA Firm in Florida',
    initials: 'CF',
  },
  {
    quote: 'Nishant has been taking care of our bookkeeping for some time now and has been doing a great job. Would recommend.',
    name: 'Kevin Volquartz',
    role: 'Running an eCommerce business on Amazon Europe',
    initials: 'KV',
  },
];
---

  <!-- ===== TESTIMONIALS ===== -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-14">
        <p
          class="uppercase mb-4"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: 18px; line-height: 31px; letter-spacing: 1.63px; color: #2738C0;"
        >
          Client Stories
        </p>
        <h2
          class="mb-4"
          style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #0F172A;"
        >
          What our
          <span
            class="inline-block"
            style="font-family: 'Segoe Script', 'Yellowtail', cursive; font-weight: 400; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #2738C0; margin: 0 0.1em;"
          >clients</span>
          say
        </h2>
        <p
          class="text-sm sm:text-base"
          style="font-family: 'DM Sans', sans-serif; font-weight: 400; color: #64748B;"
        >
          Trusted by 280+ businesses across US &amp; UAE
        </p>
      </div>
    </div>

    <div class="relative w-full overflow-hidden">
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-12 sm:w-20 z-10" style="background: linear-gradient(to right, #ffffff, transparent);"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-12 sm:w-20 z-10" style="background: linear-gradient(to left, #ffffff, transparent);"></div>

      <div class="flex w-max animate-marquee-continuous">
        {[...Array(2)].map(() => (
          <div class="flex items-stretch gap-5 pr-5">
            {testimonials.map((t) => (
              <div
                class="p-8 rounded-2xl border border-gray-100 bg-white flex flex-col flex-shrink-0"
                style="width: min(360px, 85vw); box-shadow: 0 1px 8px rgba(15,23,42,0.04);"
              >
                <div class="flex gap-0.5 mb-4">
                  {[1, 2, 3, 4, 5].map(() => (
                    <svg class="w-4 h-4" style="color: #f59e0b;" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <svg class="w-7 h-7 mb-3 opacity-10" style="color: #1a4480;" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
                <p class="text-sm text-gray-600 leading-relaxed mb-6 italic flex-1">"{t.quote}"</p>
                <div class="flex items-center gap-3 pt-5 border-t border-gray-100">
                  <div
                    class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-white text-xs font-bold"
                    style="background-color: #1a4480;"
                  >
                    {t.initials}
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">{t.name}</p>
                    <p class="text-xs text-gray-400">{t.role}</p>
                  </div>
                </div>
              </div>
            ))}
 
           </div>
        ))}
      </div>
    </div>
  </section>
