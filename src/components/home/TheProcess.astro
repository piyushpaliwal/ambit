              />
              <!-- Right Curved Branch & Vertical Line -->
              <path
                d="M 205 200 C 192 178, 165 157, 126 157 L 126 140"
                :stroke="activeStep === 3 ? '#C7A771' : '#94A3B8'"
                :stroke-width="activeStep === 3 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 3 && 'process-arc-active-gold'"
              />
              <!-- Left Endpoint Node -->
              <circle cx="35" cy="200" r="7" :fill="activeStep === 3 ? '#C7A771' : '#C7A771'" class="transition-all duration-300" />
              <!-- Right Endpoint Node -->
              <circle cx="205" cy="200" r="7" :fill="activeStep === 3 ? '#C7A771' : '#C7A771'" class="transition-all duration-300" />
            </svg>

            <!-- Card 4 (Top) -->
            <div
              class="absolute top-[0px] left-0 right-0 bg-white rounded-[18px] px-4 py-4 text-center z-20 transition-all duration-500 border"
              :class="activeStep === 3 ? 'shadow-xl border-[#C7A771] ring-4 ring-[#C7A771]/20' : 'border-[#CBD5E1] shadow-sm'"
            >
              <h3 class="mb-1.5 text-[18px] font-semibold text-[#0F172A]" style="font-family: 'DM Sans', sans-serif;">
                Delivery &amp; Review
              </h3>
              <p class="text-[13px] leading-[19px] text-[#475569]" style="font-family: 'DM Sans', sans-serif;">
                Work is executed with defined review layers ensuring accuracy, consistency, and alignment across reporting periods.
              </p>
            </div>

            <!-- Large Gold Icon Circle (Bottom) -->
            <div class="absolute top-[180px] left-1/2 -translate-x-1/2 flex items-center justify-center z-10">
              <div
                class="absolute inset-0 rounded-full transition-all duration-500 pointer-events-none"
                :class="activeStep === 3 ? 'scale-125 opacity-100 bg-[#C7A771]/15 animate-ping' : 'opacity-0'"
              ></div>

              <div
                class="w-[156px] h-[156px] rounded-full flex items-center justify-center relative z-10 transition-all duration-500"
                :class="activeStep === 3 ? 'shadow-2xl ring-4 ring-[#C7A771]/20' : ''"
                style="background-color: #C7A771; border: 6px solid #FFFFFF; box-shadow: 0 12px 32px rgba(199,167,113,0.3);"
              >
                <!-- Mail with Checkmark Icon -->
                <svg class="w-14 h-14 text-white transition-transform duration-500 group-hover:-translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 6h16a2 2 0 0 1 2 2v7" />
                  <path d="M22 9l-10 6L2 9" />
                  <path d="M2 8v10a2 2 0 0 0 2 2h9" />
                  <path d="M16 18l2.5 2.5 4.5-4.5" />
                </svg>
              </div>
            </div>
          </div>

          <!-- STAGE 5: Continuity (Navy Icon Top, Card Bottom) -->
          <div
            class="relative top-[35px] h-[530px] cursor-pointer group transition-all duration-500"
            :class="activeStep === 4 ? 'scale-[1.02] -translate-y-2' : 'hover:-translate-y-1.5 hover:scale-[1.01]'"
            @mouseenter="hoveredStep = 4; activeStep = 4"
            @click="selectStep(4)"
          >
            <!-- Independent Split Connector SVG for Stage 5 -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none z-0"
              viewBox="0 0 240 530"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <!-- Left Curved Branch & Vertical Line -->
              <path
                d="M 35 205 C 48 228, 75 248, 114 248 L 114 265"
                :stroke="activeStep === 4 ? '#0B1B32' : '#94A3B8'"
                :stroke-width="activeStep === 4 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
