                :stroke="activeStep === 4 ? '#0B1B32' : '#94A3B8'"
                :stroke-width="activeStep === 4 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 4 && 'process-arc-active'"
              />
              <!-- Left Endpoint Node -->
              <circle cx="35" cy="205" r="7" :fill="activeStep === 4 ? '#0B1B32' : '#0B1B32'" class="transition-all duration-300" />
              <!-- Right Endpoint Node -->
              <circle cx="205" cy="205" r="7" :fill="activeStep === 4 ? '#0B1B32' : '#0B1B32'" class="transition-all duration-300" />
