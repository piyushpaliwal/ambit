              <!-- Right Curved Branch & Vertical Line -->
              <path
                d="M 205 200 C 192 178, 165 157, 126 157 L 126 140"
                :stroke="activeStep === 1 ? '#C7A771' : '#94A3B8'"
                :stroke-width="activeStep === 1 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 1 && 'process-arc-active-gold'"
              />
              <!-- Left Endpoint Node -->
              <circle cx="35" cy="200" r="7" :fill="activeStep === 1 ? '#C7A771' : '#C7A771'" class="transition-all duration-300" />
              <!-- Right Endpoint Node -->
              <circle cx="205" cy="200" r="7" :fill="activeStep === 1 ? '#C7A771' : '#C7A771'" class="transition-all duration-300" />
            </svg>

            <!-- Card 2 (Top) -->
            <div
              class="absolute top-[0px] left-0 right-0 bg-white rounded-[18px] px-4 py-4 text-center z-20 transition-all duration-500 border"
              :class="activeStep === 1 ? 'shadow-xl border-[#C7A771] ring-4 ring-[#C7A771]/20' : 'border-[#CBD5E1] shadow-sm'"
            >
              <h3 class="mb-1.5 text-[18px] font-semibold text-[#0F172A]" style="font-family: 'DM Sans', sans-serif;">
                Structuring
              </h3>
              <p class="text-[13px] leading-[19px] text-[#475569]" style="font-family: 'DM Sans', sans-serif;">
                Scope, processes, and delivery model are defined and aligned to your environment and reporting requirements.
              </p>
            </div>

            <!-- Large Gold Icon Circle (Bottom) -->
            <div class="absolute top-[180px] left-1/2 -translate-x-1/2 flex items-center justify-center z-10">
              <div
                class="absolute inset-0 rounded-full transition-all duration-500 pointer-events-none"
                :class="activeStep === 1 ? 'scale-125 opacity-100 bg-[#C7A771]/15 animate-ping' : 'opacity-0'"
              ></div>

              <div
                class="w-[156px] h-[156px] rounded-full flex items-center justify-center relative z-10 transition-all duration-500"
                :class="activeStep === 1 ? 'shadow-2xl ring-4 ring-[#C7A771]/20' : ''"
                style="background-color: #C7A771; border: 6px solid #FFFFFF; box-shadow: 0 12px 32px rgba(199,167,113,0.3);"
              >
                <!-- 3D Pyramid Wireframe Icon -->
                <svg class="w-14 h-14 text-white transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 L2.5 20 L21.5 20 Z" />
                  <path d="M12 3 L12 14" />
                  <path d="M12 14 L2.5 20" />
                  <path d="M12 14 L21.5 20" />
                </svg>
              </div>
            </div>
          </div>

          <!-- STAGE 3: Onboarding (Navy Icon Top, Card Bottom) -->
          <div
            class="relative top-[35px] h-[530px] cursor-pointer group transition-all duration-500"
            :class="activeStep === 2 ? 'scale-[1.02] -translate-y-2' : 'hover:-translate-y-1.5 hover:scale-[1.01]'"
            @mouseenter="hoveredStep = 2; activeStep = 2"
            @click="selectStep(2)"
          >
            <!-- Independent Split Connector SVG for Stage 3 -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none z-0"
              viewBox="0 0 240 530"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <!-- Left Curved Branch & Vertical Line -->
              <path
                d="M 35 205 C 48 228, 75 248, 114 248 L 114 265"
                :stroke="activeStep === 2 ? '#0B1B32' : '#94A3B8'"
                :stroke-width="activeStep === 2 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 2 && 'process-arc-active'"
              />
              <!-- Right Curved Branch & Vertical Line -->
              <path
                d="M 205 205 C 192 228, 165 248, 126 248 L 126 265"
                :stroke="activeStep === 2 ? '#0B1B32' : '#94A3B8'"
                :stroke-width="activeStep === 2 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 2 && 'process-arc-active'"
              />
              <!-- Left Endpoint Node -->
              <circle cx="35" cy="205" r="7" :fill="activeStep === 2 ? '#0B1B32' : '#0B1B32'" class="transition-all duration-300" />
              <!-- Right Endpoint Node -->
              <circle cx="205" cy="205" r="7" :fill="activeStep === 2 ? '#0B1B32' : '#0B1B32'" class="transition-all duration-300" />
            </svg>

            <!-- Large Navy Icon Circle (Top) -->
            <div class="absolute top-[80px] left-1/2 -translate-x-1/2 flex items-center justify-center z-10">
              <div
                class="absolute inset-0 rounded-full transition-all duration-500 pointer-events-none"
                :class="activeStep === 2 ? 'scale-125 opacity-100 bg-[#0B1B32]/10 animate-ping' : 'opacity-0'"
              ></div>

              <div
                class="w-[156px] h-[156px] rounded-full flex items-center justify-center relative z-10 transition-all duration-500"
                :class="activeStep === 2 ? 'shadow-2xl ring-4 ring-[#0B1B32]/15' : ''"
                style="background-color: #0B1B32; border: 6px solid #FFFFFF; box-shadow: 0 12px 32px rgba(11,27,50,0.22);"
              >
                <!-- Handshake Icon -->
                <svg class="w-14 h-14 text-white transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2.6-2.6a1 1 0 0 0-1.4 0l-1.2 1.2" />
                  <path d="m13 7-2-2a1 1 0 0 0-1.4 0L5.3 9.3a1 1 0 0 0 0 1.4l2.6 2.6a1 1 0 0 0 1.4 0l1.2-1.2" />
                  <path d="M18 11V6a2 2 0 0 0-2-2" />
                  <path d="M6 13v5a2 2 0 0 0 2 2" />
                </svg>
              </div>
            </div>

            <!-- Card 3 (Bottom) -->
            <div
              class="absolute top-[265px] left-0 right-0 bg-white rounded-[18px] px-4 py-4 text-center z-20 transition-all duration-500 border"
              :class="activeStep === 2 ? 'shadow-xl border-[#0B1B32] ring-4 ring-[#0B1B32]/10' : 'border-[#CBD5E1] shadow-sm'"
            >
              <h3 class="mb-1.5 text-[18px] font-semibold text-[#0F172A]" style="font-family: 'DM Sans', sans-serif;">
                Onboarding
              </h3>
              <p class="text-[13px] leading-[19px] text-[#475569]" style="font-family: 'DM Sans', sans-serif;">
                Systems, access, and workflows are established in a controlled manner, ready for consistent delivery from day one.
              </p>
            </div>
          </div>

          <!-- STAGE 4: Delivery & Review (Card Top, Gold Icon Bottom) -->
          <div
            class="relative -top-[15px] h-[530px] cursor-pointer group transition-all duration-500"
            :class="activeStep === 3 ? 'scale-[1.02] -translate-y-2' : 'hover:-translate-y-1.5 hover:scale-[1.01]'"
            @mouseenter="hoveredStep = 3; activeStep = 3"
            @click="selectStep(3)"
