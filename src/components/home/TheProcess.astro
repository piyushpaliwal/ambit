---
---

  <!-- ===== THE PROCESS / HOW WE WORK ===== -->
  <section id="process" class="py-20 lg:py-28 relative overflow-hidden" style="background-color: #E8E4DB;">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
      x-data="{
        activeStep: 0,
        hoveredStep: null,
        autoPlay: true,
        intervalId: null,
        startAutoPlay() {
          this.stopAutoPlay();
          if (!this.autoPlay) return;
          this.intervalId = window.setInterval(() => {
            if (this.hoveredStep === null && this.autoPlay) {
              this.activeStep = (this.activeStep + 1) % 5;
            }
          }, 4000);
        },
        stopAutoPlay() {
          if (this.intervalId != null) {
            window.clearInterval(this.intervalId);
            this.intervalId = null;
          }
        },
        toggleAutoPlay() {
          this.autoPlay = !this.autoPlay;
          this.hoveredStep = null;
          if (this.autoPlay) this.startAutoPlay();
          else this.stopAutoPlay();
        },
        selectStep(i) {
          this.activeStep = i;
        },
        pauseTour() {
          this.stopAutoPlay();
        },
        resumeTour() {
          this.hoveredStep = null;
          if (this.autoPlay) this.startAutoPlay();
        }
      }"
      x-init="
        startAutoPlay();
        const self = $data;
        const section = $el.closest('section');
        if (section && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            const entry = entries[0];
            if (!entry) return;
            if (entry.isIntersecting) {
              self.hoveredStep = null;
              if (self.autoPlay) self.startAutoPlay();
            } else {
              self.stopAutoPlay();
            }
          }, { threshold: 0.15 });
          io.observe(section);
        }
      "
    >
      <!-- Section Header: Left Aligned Editorial Header + Right Aligned Auto-Tour Controls -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 lg:mb-16">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3.5" style="background: rgba(11,27,50,0.08); color: #2738C0;">
            <span class="w-2 h-2 rounded-full animate-ping" style="background-color: #2738C0;"></span>
            How We Work
          </div>
          <h2
            class="mb-3 max-w-3xl"
            style="font-family: 'DM Sans', sans-serif; font-weight: 500; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #0F172A;"
          >
            A clear path to
            <span
              class="inline-block relative"
              style="font-family: 'Segoe Script', 'Yellowtail', cursive; font-weight: 400; font-size: clamp(28px, 4vw, 40px); line-height: 41px; letter-spacing: 0; color: #2738C0; margin: 0 0.12em;"
            >
              Financial
            </span>
            clarity
          </h2>
          <p
            class="max-w-2xl text-base sm:text-lg"
            style="font-family: 'DM Sans', sans-serif; font-weight: 400; color: #475569;"
          >
            Five stages, each with a defined output. You always know what has been done, what is next and who owns it.
          </p>
        </div>

        <!-- Interactive Step Scrubber / Auto-tour Controls -->
        <div class="flex items-center gap-2 self-start lg:self-end bg-white/80 backdrop-blur-md px-3.5 py-2 rounded-2xl border border-slate-300/70 shadow-sm">
          <button
            @click="toggleAutoPlay()"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all cursor-pointer"
            :class="autoPlay ? 'bg-[#0B1B32] text-white shadow-sm' : 'bg-slate-200/80 text-slate-700 hover:bg-slate-300/80'"
            title="Toggle Auto Tour"
          >
            <template x-if="autoPlay">
              <svg class="w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12" /></svg>
            </template>
            <template x-if="!autoPlay">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg>
            </template>
            <span x-text="autoPlay ? 'Auto Tour: ON' : 'Auto Tour: OFF'"></span>
          </button>

          <div class="hidden sm:flex items-center gap-1">
            {[
              { num: '01', name: 'Understanding' },
              { num: '02', name: 'Structuring' },
              { num: '03', name: 'Onboarding' },
              { num: '04', name: 'Delivery & Review' },
              { num: '05', name: 'Continuity' }
            ].map((p, idx) => (
              <button
                @click={`selectStep(${idx})`}
                class="px-2.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer"
                :class={`activeStep === ${idx} ? 'bg-[#0B1B32] text-white shadow-md scale-105' : 'text-slate-600 hover:bg-white/80'`}
              >
                {p.num}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Desktop Horizontal Editorial Timeline (5 Stages) -->
      <div
        class="hidden lg:block relative process-timeline w-full mx-auto h-[530px] my-4 select-none"
        @mouseenter="pauseTour()"
        @mouseleave="resumeTour()"
      >
        <!-- 5-Column Grid with Alternating Cards & Icons -->
        <div class="grid grid-cols-5 gap-[5px] relative z-10 h-[530px]">

          <!-- STAGE 1: Understanding (Navy Icon Top, Card Bottom) -->
          <div
            class="relative top-[35px] h-[530px] cursor-pointer group transition-all duration-500"
            :class="activeStep === 0 ? 'scale-[1.02] -translate-y-2' : 'hover:-translate-y-1.5 hover:scale-[1.01]'"
            @mouseenter="hoveredStep = 0; activeStep = 0"
            @click="selectStep(0)"
          >
            <!-- Independent Split Connector SVG for Stage 1 -->
            <svg
              class="absolute inset-0 w-full h-full pointer-events-none z-0"
              viewBox="0 0 240 530"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <!-- Left Curved Branch & Vertical Line -->
              <path
                d="M 35 205 C 48 228, 75 248, 114 248 L 114 265"
                :stroke="activeStep === 0 ? '#0B1B32' : '#94A3B8'"
                :stroke-width="activeStep === 0 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 0 && 'process-arc-active'"
              />
              <!-- Right Curved Branch & Vertical Line -->
              <path
                d="M 205 205 C 192 228, 165 248, 126 248 L 126 265"
                :stroke="activeStep === 0 ? '#0B1B32' : '#94A3B8'"
                :stroke-width="activeStep === 0 ? '2.5' : '1.75'"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-all duration-300"
                :class="activeStep === 0 && 'process-arc-active'"
              />
              <!-- Left Endpoint Node -->
              <circle cx="35" cy="205" r="7" :fill="activeStep === 0 ? '#0B1B32' : '#0B1B32'" class="transition-all duration-300" />
              <!-- Right Endpoint Node -->
              <circle cx="205" cy="205" r="7" :fill="activeStep === 0 ? '#0B1B32' : '#0B1B32'" class="transition-all duration-300" />
            </svg>

            <!-- Large Navy Icon Circle (Top) -->
            <div class="absolute top-[80px] left-1/2 -translate-x-1/2 flex items-center justify-center z-10">
              <div
                class="absolute inset-0 rounded-full transition-all duration-500 pointer-events-none"
                :class="activeStep === 0 ? 'scale-125 opacity-100 bg-[#0B1B32]/10 animate-ping' : 'opacity-0'"
              ></div>

              <div
                class="w-[156px] h-[156px] rounded-full flex items-center justify-center relative z-10 transition-all duration-500"
                :class="activeStep === 0 ? 'shadow-2xl ring-4 ring-[#0B1B32]/15' : ''"
                style="background-color: #0B1B32; border: 6px solid #FFFFFF; box-shadow: 0 12px 32px rgba(11,27,50,0.22);"
              >
                <!-- Lightbulb Icon -->
                <svg class="w-14 h-14 text-white transition-transform duration-500 group-hover:rotate-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a7 7 0 0 0-7 7c0 2.5 1.5 4.5 3 6h8c1.5-1.5 3-3.5 3-6a7 7 0 0 0-7-7z" />
                  <path d="M9 18h6" />
                  <path d="M10 21h4" />
                </svg>
              </div>
            </div>

            <!-- Card 1 (Bottom) -->
            <div
              class="absolute top-[265px] left-0 right-0 bg-white rounded-[18px] px-4 py-4 text-center z-20 transition-all duration-500 border"
              :class="activeStep === 0 ? 'shadow-xl border-[#0B1B32] ring-4 ring-[#0B1B32]/10' : 'border-[#CBD5E1] shadow-sm'"
            >
              <h3 class="mb-1.5 text-[18px] font-semibold text-[#0F172A]" style="font-family: 'DM Sans', sans-serif;">
                Understanding
              </h3>
              <p class="text-[13px] leading-[19px] text-[#475569]" style="font-family: 'DM Sans', sans-serif;">
                We review your current setup, systems, and workflows to identify where structure and consistency are needed.
              </p>
            </div>
          </div>

          <!-- STAGE 2: Structuring (Card Top, Gold Icon Bottom) -->
          <div
            class="relative -top-[15px] h-[530px] cursor-pointer group transition-all duration-500"
            :class="activeStep === 1 ? 'scale-[1.02] -translate-y-2' : 'hover:-translate-y-1.5 hover:scale-[1.01]'"
