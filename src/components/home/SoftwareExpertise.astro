---
import { softwareTools } from '../../data/softwareTools';
---

  <!-- ===== SOFTWARE EXPERTISE ===== -->
  <section class="py-16 bg-white" style="border-top: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold tracking-[0.15em] uppercase mb-2" style="color: #1a4480;">Technology</p>
        <h2 class="text-2xl font-bold" style="color: #0F172A; letter-spacing: -0.02em;">Tools & Software We Use</h2>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-5">
        {softwareTools.map(tool => (
          <div class="flex items-center gap-3 px-5 py-3.5 rounded-xl border border-gray-100 bg-white hover:border-slate-200 hover:shadow-md hover:-translate-y-0.5 transition-all group cursor-default">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center p-1.5 bg-white border border-gray-100 shadow-sm flex-shrink-0 overflow-hidden">
              <img src={tool.logo} alt={tool.name} class="w-full h-full object-contain" loading="lazy" />
            </div>
            <div>
              <div class="text-sm font-semibold text-gray-700">{tool.name}</div>
              <div class="text-xs text-gray-400">{tool.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
