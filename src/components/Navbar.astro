---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const initialCountry = currentPath.includes('/uae') ? 'UAE' : 'US';
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<div
  x-data={`{
    mobileOpen: false,
    scrolled: false,
    servicesOpen: false,
    activePillar: 'finance',
    mobileServicesOpen: false,
    mobileFinanceOpen: false,
    mobileUSOpen: false,
    mobileUAEOpen: false,
    countryOpen: false,
    country: '${initialCountry}',
    lang: 'EN',
    isHome: ${isHome}
  }`}
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 20 })"
  class={`w-full z-[60] ${isHome ? 'fixed top-0' : 'sticky top-0'}`}
>
  <!-- TOP UTILITY BAR -->
  <div class="w-full text-sm" style="background-color: #C4A574;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-10">
        <!-- Left: country dropdown + phone -->
        <div class="flex items-center gap-4">
          <div class="relative" @click.outside="countryOpen = false">
            <button
              type="button"
              @click="countryOpen = !countryOpen"
              class="flex items-center gap-1.5 text-xs font-semibold transition-colors"
              style="color: #1a1a1a;"
            >
              <!-- Selected Country Flag -->
              <span class="inline-flex items-center">
                <template x-if="country === 'US'">
                  <svg class="w-4 h-3 rounded-[2px] shadow-xs" viewBox="0 0 640 480"><g fill-rule="evenodd"><path fill="#bd3d44" d="M0 0h640v480H0"/><path stroke="#fff" stroke-width="37" d="M0 55.4h640M0 129.2h640M0 203h640M0 277h640M0 350.8h640M0 424.6h640"/><path fill="#192f5d" d="M0 0h256v258.5H0z"/><circle cx="30" cy="30" r="8" fill="#fff"/><circle cx="80" cy="30" r="8" fill="#fff"/><circle cx="130" cy="30" r="8" fill="#fff"/><circle cx="180" cy="30" r="8" fill="#fff"/><circle cx="230" cy="30" r="8" fill="#fff"/><circle cx="55" cy="65" r="8" fill="#fff"/><circle cx="105" cy="65" r="8" fill="#fff"/><circle cx="155" cy="65" r="8" fill="#fff"/><circle cx="205" cy="65" r="8" fill="#fff"/><circle cx="30" cy="100" r="8" fill="#fff"/><circle cx="80" cy="100" r="8" fill="#fff"/><circle cx="130" cy="100" r="8" fill="#fff"/><circle cx="180" cy="100" r="8" fill="#fff"/><circle cx="230" cy="100" r="8" fill="#fff"/><circle cx="55" cy="135" r="8" fill="#fff"/><circle cx="105" cy="135" r="8" fill="#fff"/><circle cx="155" cy="135" r="8" fill="#fff"/><circle cx="205" cy="135" r="8" fill="#fff"/><circle cx="30" cy="170" r="8" fill="#fff"/><circle cx="80" cy="170" r="8" fill="#fff"/><circle cx="130" cy="170" r="8" fill="#fff"/><circle cx="180" cy="170" r="8" fill="#fff"/><circle cx="230" cy="170" r="8" fill="#fff"/><circle cx="55" cy="205" r="8" fill="#fff"/><circle cx="105" cy="205" r="8" fill="#fff"/><circle cx="155" cy="205" r="8" fill="#fff"/><circle cx="205" cy="205" r="8" fill="#fff"/></g></svg>
                </template>
                <template x-if="country === 'UAE'">
                  <svg class="w-4 h-3 rounded-[2px] shadow-xs" viewBox="0 0 640 480"><path fill="#00732f" d="M0 0h640v160H0z"/><path fill="#fff" d="M0 160h640v160H0z"/><path fill="#000" d="M0 320h640v160H0z"/><path fill="#f00" d="M0 0h210v480H0z"/></svg>
                </template>
              </span>
              <span x-text="country">US</span>
              <svg class="w-3 h-3 transition-transform duration-200" :class="countryOpen ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div
              x-show="countryOpen"
              x-cloak
              x-transition:enter="transition ease-out duration-150"
              x-transition:enter-start="opacity-0 -translate-y-1"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-100"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-1"
              class="absolute left-0 top-full mt-1 min-w-[5.5rem] rounded-md shadow-lg overflow-hidden z-50 py-1"
              style="background-color: #fff; display: none;"
            >
              <a
                href="/services/finance-accounting-tax/us/overview"
                @click="country = 'US'; countryOpen = false"
                class="flex items-center gap-2 px-3 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50 transition-colors"
              >
                <svg class="w-4 h-3 rounded-[2px] shadow-xs flex-shrink-0" viewBox="0 0 640 480"><g fill-rule="evenodd"><path fill="#bd3d44" d="M0 0h640v480H0"/><path stroke="#fff" stroke-width="37" d="M0 55.4h640M0 129.2h640M0 203h640M0 277h640M0 350.8h640M0 424.6h640"/><path fill="#192f5d" d="M0 0h256v258.5H0z"/><circle cx="30" cy="30" r="8" fill="#fff"/><circle cx="80" cy="30" r="8" fill="#fff"/><circle cx="130" cy="30" r="8" fill="#fff"/><circle cx="180" cy="30" r="8" fill="#fff"/><circle cx="230" cy="30" r="8" fill="#fff"/><circle cx="55" cy="65" r="8" fill="#fff"/><circle cx="105" cy="65" r="8" fill="#fff"/><circle cx="155" cy="65" r="8" fill="#fff"/><circle cx="205" cy="65" r="8" fill="#fff"/><circle cx="30" cy="100" r="8" fill="#fff"/><circle cx="80" cy="100" r="8" fill="#fff"/><circle cx="130" cy="100" r="8" fill="#fff"/><circle cx="180" cy="100" r="8" fill="#fff"/><circle cx="230" cy="100" r="8" fill="#fff"/><circle cx="55" cy="135" r="8" fill="#fff"/><circle cx="105" cy="135" r="8" fill="#fff"/><circle cx="155" cy="135" r="8" fill="#fff"/><circle cx="205" cy="135" r="8" fill="#fff"/><circle cx="30" cy="170" r="8" fill="#fff"/><circle cx="80" cy="170" r="8" fill="#fff"/><circle cx="130" cy="170" r="8" fill="#fff"/><circle cx="180" cy="170" r="8" fill="#fff"/><circle cx="230" cy="170" r="8" fill="#fff"/><circle cx="55" cy="205" r="8" fill="#fff"/><circle cx="105" cy="205" r="8" fill="#fff"/><circle cx="155" cy="205" r="8" fill="#fff"/><circle cx="205" cy="205" r="8" fill="#fff"/></g></svg>
                <span>US</span>
              </a>
              <a
                href="/services/finance-accounting-tax/uae/overview"
                @click="country = 'UAE'; countryOpen = false"
                class="flex items-center gap-2 px-3 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50 transition-colors"
              >
                <svg class="w-4 h-3 rounded-[2px] shadow-xs flex-shrink-0" viewBox="0 0 640 480"><path fill="#00732f" d="M0 0h640v160H0z"/><path fill="#fff" d="M0 160h640v160H0z"/><path fill="#000" d="M0 320h640v160H0z"/><path fill="#f00" d="M0 0h210v480H0z"/></svg>
                <span>UAE</span>
              </a>
            </div>
          </div>

          <a
            :href="country === 'UAE' ? 'tel:+971567105833' : 'tel:+17068949160'"
            class="hidden sm:inline text-xs font-medium transition-colors hover:underline"
            style="color: #1a1a1a;"
          >
            <span x-text="country === 'UAE' ? 'Speak to our UAE team: +971 567105833' : 'Speak to our US team: +1 (706) 894-9160'">
              {initialCountry === 'UAE' ? 'Speak to our UAE team: +971 567105833' : 'Speak to our US team: +1 (706) 894-9160'}
            </span>
          </a>
        </div>

        <!-- Right: EN/ES pill -->
        <!-- <div class="flex items-center rounded-full p-0.5" style="background-color: #1a4480;">
          <button
            type="button"
            @click="lang = 'EN'"
            class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full transition-colors"
            :class="lang === 'EN' ? 'bg-white text-[#1a4480]' : 'text-white/80 hover:text-white'"
          >EN</button>
          <button
            type="button"
            @click="lang = 'ES'"
            class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full transition-colors"
            :class="lang === 'ES' ? 'bg-white text-[#1a4480]' : 'text-white/80 hover:text-white'"
          >ES</button>
        </div> -->
      </div>
    </div>
  </div>

  <!-- MAIN NAV -->
  <nav
    class="w-full transition-all duration-300"
    :class="(!isHome || scrolled) ? 'bg-white shadow-md border-b border-gray-100' : 'bg-transparent'"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between min-h-[77px] h-[77px] lg:h-[88px]">

        <!-- Logo — 164×77 (design): white on hero, color logo when scrolled -->
        <a
          href="/"
          class="flex items-center flex-shrink-0"
          style="width: 164px; height: 77px; opacity: 1;"
        >
          <img
            src={isHome ? '/images/logo-white.png' : '/images/ambit_logo.png'}
            :src="(!isHome || scrolled) ? '/images/ambit_logo.png' : '/images/logo-white.png'"
            alt="Ambit Tax and Accounting Services"
            width="164"
            height="77"
            class="w-[164px] h-[77px] object-contain object-left transition-opacity duration-300"
            style="opacity: 1;"
          />
        </a>

        <!-- Desktop Nav Links -->
        <div class="hidden lg:flex items-center gap-0.5">
          <a
            href="/"
            class="px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >Home</a>
          <a
            href="/about"
            class="px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/about') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >About Us</a>

          <!-- Services trigger -->
          <button
            type="button"
            @mouseenter="servicesOpen = true"
            @click="servicesOpen = !servicesOpen"
            class="flex items-center gap-1 px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/services') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >
            Services
            <svg class="w-3.5 h-3.5 transition-transform duration-200" :class="servicesOpen ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>

          <a
            href="/industries"
            class="px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/industries') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >Industries</a>
          <a
            href="/how-it-works"
            class="px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/how-it-works') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >How It Works</a>
          <a
            href="/blog"
            class="px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/blog') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >Blogs</a>
          <a
            href="/contact"
            class="px-3 py-2 text-sm font-medium transition-colors duration-300"
            :class={`(!isHome || scrolled) ? '${isActive('/contact') ? 'text-[#0F172A] font-semibold' : 'text-gray-600 hover:text-gray-900'}' : 'text-white/90 hover:text-white'`}
          >Contact</a>
        </div>

        <!-- CTA -->
        <div class="hidden lg:block">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 pl-5 pr-1.5 py-1.5 text-sm font-semibold rounded-full transition-all duration-300 hover:opacity-90"
            :class="(isHome && !scrolled) ? 'bg-white text-[#1a4480]' : 'text-white'"
            :style="(isHome && !scrolled) ? '' : 'background-color: #1a4480;'"
          >
            Book Free Consultation
            <span
              class="flex items-center justify-center w-8 h-8 rounded-full transition-colors duration-300"
              :class="(isHome && !scrolled) ? 'bg-[#1a4480] text-white' : 'bg-white/20 text-white'"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        </div>

        <!-- Mobile toggle -->
        <button
          type="button"
          @click="mobileOpen = !mobileOpen"
          class="lg:hidden p-2 transition-colors duration-300"
          :class="(!isHome || scrolled) ? 'text-gray-600 hover:text-gray-900' : 'text-white hover:text-white/80'"
        >
          <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg x-show="mobileOpen" x-cloak class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- ===== SERVICES MEGA MENU ===== -->
    <div
      x-show="servicesOpen"
      x-cloak
      @click="servicesOpen = false"
      class="fixed inset-0"
      style="z-index: 40; display: none;"
    ></div>

    <div
      x-show="servicesOpen"
      x-cloak
      @mouseleave="servicesOpen = false"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-1"
      class="absolute left-0 right-0 hidden lg:block"
      style="top: 100%; z-index: 50; display: none;"
    >
      <div style="background-color: #0F172A; border-top: 2px solid #1a4480; box-shadow: 0 20px 60px rgba(0,0,0,0.5);">
        <div style="max-width: 1440px; margin: 0 auto; padding: 2.5rem 3rem;">
          <div style="display: grid; grid-template-columns: 240px 260px 1fr; gap: 0;">

            <!-- Col 1: Static Block -->
            <div style="padding-right: 2.5rem; border-right: 1px solid #1E293B;">
              <div class="text-xs font-bold uppercase tracking-widest mb-2" style="color: #475569;">Services</div>
              <h2 class="text-2xl font-black mb-4 leading-tight" style="color: #F8FAFC; letter-spacing: -0.02em;">Three pillars.<br/>One partner.</h2>
              <p class="text-sm leading-relaxed mb-8" style="color: #64748B;">
                Three delivery pillars structured across Finance, Accounting and Tax, Business Process Support, and Workforce Solutions. Designed to integrate into existing systems and workflows, ensuring delivery remains consistent across functions and markets.
              </p>
              <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <a href="/services" class="flex items-center gap-2 px-4 py-2.5 rounded text-sm font-semibold text-white transition-all hover:opacity-90" style="background-color: #1a4480;">
                  Explore Services
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
                <a href="/contact" class="flex items-center justify-center px-4 py-2.5 rounded text-sm font-semibold transition-all hover:bg-white/5" style="color: #94A3B8; border: 1px solid #334155;">
                  Book a Consultation
                </a>
              </div>
            </div>

            <!-- Col 2: Pillar Tabs -->
            <div style="padding: 0 2rem; border-right: 1px solid #1E293B;">
              <div class="text-xs font-bold uppercase tracking-widest mb-5" style="color: #475569;">Pillars</div>
              <div style="display: flex; flex-direction: column; gap: 0.25rem;">

                <button
                  type="button"
                  @mouseenter="activePillar = 'finance'"
                  class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-left text-sm font-semibold transition-all"
                  :style="activePillar === 'finance' ? 'background-color: #1E293B; color: #F8FAFC;' : 'color: #64748B; background: transparent;'"
                >
                  <span>Finance, Accounting &amp; Tax</span>
                  <svg class="w-4 h-4 flex-shrink-0 ml-2" :style="activePillar === 'finance' ? 'color: #1a4480;' : 'color: #334155;'" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>

                <button
                  type="button"
                  @mouseenter="activePillar = 'bpo'"
                  class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-left text-sm font-semibold transition-all"
                  :style="activePillar === 'bpo' ? 'background-color: #1E293B; color: #F8FAFC;' : 'color: #64748B; background: transparent;'"
                >
                  <span>BPO Services</span>
                  <svg class="w-4 h-4 flex-shrink-0 ml-2" :style="activePillar === 'bpo' ? 'color: #1a4480;' : 'color: #334155;'" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>

                <button
                  type="button"
                  @mouseenter="activePillar = 'rpo'"
                  class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-left text-sm font-semibold transition-all"
                  :style="activePillar === 'rpo' ? 'background-color: #1E293B; color: #F8FAFC;' : 'color: #64748B; background: transparent;'"
                >
                  <span>RPO Services</span>
                  <svg class="w-4 h-4 flex-shrink-0 ml-2" :style="activePillar === 'rpo' ? 'color: #1a4480;' : 'color: #334155;'" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>

              </div>
            </div>

            <!-- Col 3: Dynamic Panel -->
            <div style="padding-left: 2.5rem;">

              <!-- Finance, Accounting & Tax -->
              <div x-show="activePillar === 'finance'" style="display: none;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                  <div class="text-xs font-bold uppercase tracking-widest" style="color: #475569;">Finance, Accounting &amp; Tax</div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem;">

                  <!-- US -->
                  <div>
                    <a href="/services/finance-accounting-tax/us/overview" class="flex items-center gap-2 mb-4 group" style="text-decoration: none;">
                      <img src="/images/flags/w20-us.png" alt="US" class="w-5 h-3.5 object-cover rounded-sm" />
                      <span class="text-xs font-bold uppercase tracking-widest" style="color: #94A3B8;">United States</span>
                    </a>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                      {[
                        ['Overview', '/services/finance-accounting-tax/us/overview'],
                        ['Accounting & Bookkeeping', '/services/finance-accounting-tax/us/accounting-bookkeeping'],
                        ['Tax Compliance', '/services/finance-accounting-tax/us/tax-compliance'],
                        ['Sales Tax Compliance', '/services/finance-accounting-tax/us/sales-tax-compliance'],
                        ['Payroll', '/services/finance-accounting-tax/us/payroll'],
                        ['Financial Management', '/services/finance-accounting-tax/us/financial-management'],
                        ['Business Formation', '/services/finance-accounting-tax/us/business-formation'],
                      ].map(([label, href]) => (
                        <li>
                          <a
                            href={href}
                            class="text-sm block py-0.5 transition-colors hover:text-white"
                            style="color: #64748B; text-decoration: none;"
                          >{label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- UAE -->
                  <div>
                    <a href="/services/finance-accounting-tax/uae/overview" class="flex items-center gap-2 mb-4 group" style="text-decoration: none;">
                      <img src="/images/flags/w20-ae.png" alt="UAE" class="w-5 h-3.5 object-cover rounded-sm" />
                      <span class="text-xs font-bold uppercase tracking-widest" style="color: #94A3B8;">Dubai / UAE</span>
                    </a>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                      {[
                        ['Overview', '/services/finance-accounting-tax/uae/overview'],
                        ['Accounting & Bookkeeping', '/services/finance-accounting-tax/uae/accounting-bookkeeping'],
                        ['Tax Compliance', '/services/finance-accounting-tax/uae/tax-compliance'],
                        ['VAT Compliance', '/services/finance-accounting-tax/uae/vat-compliance'],
                        ['Payroll', '/services/finance-accounting-tax/uae/payroll'],
                        ['Financial Management', '/services/finance-accounting-tax/uae/financial-management'],
                        ['Business Formation', '/services/finance-accounting-tax/uae/business-formation'],
                      ].map(([label, href]) => (
                        <li>
                          <a
                            href={href}
                            class="text-sm block py-0.5 transition-colors hover:text-white"
                            style="color: #64748B; text-decoration: none;"
                          >{label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>

                </div>
              </div>

              <!-- BPO Panel -->
              <div x-show="activePillar === 'bpo'" style="display: none; max-width: 480px;">
                <div class="text-xs font-bold uppercase tracking-widest mb-6" style="color: #475569;">BPO Services</div>
                <h3 class="text-xl font-black mb-4 leading-snug" style="color: #F8FAFC; letter-spacing: -0.02em;">
                  Operational support across finance functions and shared services.
                </h3>
                <p class="text-sm leading-relaxed mb-4" style="color: #64748B;">
                  Operational support across finance functions, shared services, and backend workflows. Designed to integrate into existing systems and maintain consistency across processes.
                </p>
                <p class="text-sm leading-relaxed mb-8" style="color: #64748B;">
                  We embed within your existing operations to run defined functions, from transaction processing to reporting workflows, without disrupting how you work.
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                  <a href="/services/bpo" class="flex items-center gap-2 px-5 py-2.5 rounded text-sm font-semibold text-white transition-all hover:opacity-90" style="background-color: #1a4480;">
                    View BPO Services
