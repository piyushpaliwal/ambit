---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import HeroFold from '../components/home/HeroFold.astro';
import ByTheNumbers from '../components/home/ByTheNumbers.astro';
import AboutUs from '../components/home/AboutUs.astro';
import WhereWeOperate from '../components/home/WhereWeOperate.astro';
import WhatWeOffer from '../components/home/WhatWeOffer.astro';
import IndustriesWeServe from '../components/home/IndustriesWeServe.astro';
import TheProcess from '../components/home/TheProcess.astro';
import BusinessMetrics from '../components/home/BusinessMetrics.astro';
import SoftwareExpertise from '../components/home/SoftwareExpertise.astro';
import Testimonials from '../components/home/Testimonials.astro';
import OurPeople from '../components/home/OurPeople.astro';
import WhyAmbitSecurity from '../components/home/WhyAmbitSecurity.astro';
import KnowledgeHub from '../components/home/KnowledgeHub.astro';
import ContactCTA from '../components/home/ContactCTA.astro';
import FAQ from '../components/home/FAQ.astro';
import ConsultationModal from '../components/home/ConsultationModal.astro';
---

<Layout
  title="Outsource Accounting & Bookkeeping Services"
  description="Ambit provides expert outsourced accounting, bookkeeping, tax, and payroll services for businesses across the US, UK, and UAE. Accurate, compliant, and cost-effective finance support."
>
  <Navbar />

  <div id="home-page">
    <HeroFold />
    <AboutUs />
    <!-- <WhereWeOperate /> -->
    <WhatWeOffer />
    <IndustriesWeServe />
    <TheProcess />
    <BusinessMetrics />
    <!-- <SoftwareExpertise /> -->
    <Testimonials />
    <OurPeople />
    <WhyAmbitSecurity />
    <KnowledgeHub />
    <ContactCTA />
    <FAQ />
    <Footer />
  </div>

  <ConsultationModal />
</Layout>

<style is:global>
  #home-page .home-fade {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.75s ease,
      transform 0.75s ease;
    will-change: opacity, transform;
  }

  #home-page .home-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #home-page .home-fade {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initHomeFade() {
    const root = document.getElementById('home-page');
    if (!root) return;

    const targets = root.querySelectorAll('section, footer');
    if (!targets.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          } else {
            entry.target.classList.remove('is-visible');
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -8% 0px',
      }
    );

    targets.forEach((el) => {
      el.classList.add('home-fade');
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.9 && rect.bottom > 40) {
        el.classList.add('is-visible');
      }
      observer.observe(el);
    });
  }

  initHomeFade();
  document.addEventListener('astro:page-load', initHomeFade);
</script>
